{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Productivity Tracker",
  "version": "0.1.0",
  "identifier": "com.productivitytracker.desktop",
  "build": {
    "frontendDist": "loading",
    "beforeBuildCommand": "npm run build:server"
  },
  "app": {
    "windows": [
      {
        "title": "Productivity Tracker",
        "width": 760,
        "height": 900,
        "minWidth": 480,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/server"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
