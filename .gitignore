# Local session data — changes with every use, not source code.
sessions.json

# Node
node_modules/

# macOS Finder folder settings — not part of the project.
.DS_Store

# The currently running timer — personal data, like sessions.json.
active.json

# Packaged server program for the desktop app (~100 MB) — rebuild with: npm run build:server
src-tauri/binaries/

# Automatic tracking log (which app was in front) — personal data.
activity.jsonl

# Nudge settings — personal data.
settings.json

# Secrets — never commit these (API keys usually live in .env files).
.env
.env.*
*.pem
*.key
*.p12

# Claude Code's personal settings for this folder (also ignored globally on this Mac,
# but listed here so it stays ignored on any computer).
.claude/settings.local.json

# Log files can contain paths or data.
*.log
npm-debug.log*
